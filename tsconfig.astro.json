{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["astro/client", "vite/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "src/**/__tests__/**", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
